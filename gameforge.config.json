{
    "project": {
        "name": "GameForgeJS",
        "version": "1.0.0",
        "author": "Camello"
    },
    "window": {
        "title": "GameForgeJS",
        "backgroundColor": "#000000",
        "resizable": true,
        "cursor": "default"
    },
    "screen": {
        "width": 640,
        "height": 480,
        "fullScreen": false,
        "pixelArt": true,
        "antialiasing": false,
        "orientation": "landscape"
    },
    "physics": {
        "enabled": true,
        "gravity": {
            "x": 0,
            "y": 9.8
        },
        "debug": false
    },
    "network": {
        "serverUrl": "ws://localhost:3000",
        "autoConnect": false,
        "syncRate": 60
    },
    "audio": {
        "masterVolume": 0.8,
        "muteOnFocusLoss": true
    },
    "assets": {
        "basePath": "./assets/",
        "preload": []
    },
    "debug": {
        "showFPS": true,
        "showHitboxes": true,
        "admin": true,
        "logLevel": "info"
    }
}
